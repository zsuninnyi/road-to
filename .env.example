# API
PORT=3001
DATABASE_URL=postgres://roadto:roadto@127.0.0.1:5432/roadto

# Better Auth (session cookies; Google OAuth)
BETTER_AUTH_SECRET=dev-only-not-secret-change-me-32ch
# Public origin the browser uses (Vite in dev). Google redirect URI:
#   {BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Strava (activity import; last 30 days until full backfill)
# Strava API settings:
#   Website: http://127.0.0.1:5173
#   Authorization Callback Domain: 127.0.0.1
# Redirect URI we send (not pasted into the domain field):
#   {BETTER_AUTH_URL}/api/v1/integrations/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional 32-byte hex. Defaults to SHA-256 of BETTER_AUTH_SECRET in local dev.
TOKEN_ENCRYPTION_KEY=

# Web (Vite proxies /api to the Fastify server in development)
VITE_API_URL=
