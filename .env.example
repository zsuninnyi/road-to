# API
PORT=3001
DATABASE_URL=postgres://roadto:roadto@127.0.0.1:5432/roadto

# Better Auth (session cookies; Google OAuth)
BETTER_AUTH_SECRET=dev-only-not-secret-change-me-32ch
# Public origin the browser uses (Vite in dev). Google redirect URI:
#   {BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web (Vite proxies /api to the Fastify server in development)
VITE_API_URL=
